{
  "name": "territorios",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @territorios/web dev",
    "build": "pnpm -r build",
    "build:mobile": "pnpm --filter @territorios/web build:mobile",
    "mobile:sync": "pnpm build:mobile && pnpm --filter @territorios/mobile exec cap sync android",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:secrets:test": "node --test \"scripts/__tests__/**/*.test.mjs\"",
    "check:size": "node scripts/check-size.mjs",
    "verify": "pnpm --filter @territorios/ui-tokens build && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:size && pnpm check:secrets && pnpm check:secrets:test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@supabase/supabase-js": "^2.118.0",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "uuid": "^11.1.1"
    }
  }
}
